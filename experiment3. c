#include <stdio.h>
#include <string.h>

int main() {
    char s[20];

    printf("Enter instruction: ");
    scanf("%19s", s);

    if (!strcmp(s, "MOV") || !strcmp(s, "ADD") ||
        !strcmp(s, "SUB") || !strcmp(s, "MUL") ||
        !strcmp(s, "DIV"))
        printf("Valid mnemonic");
    else
        printf("Invalid mnemonic");

    return 0;
}
